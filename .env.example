# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pbn_realty

# Claude API for Market Analysis & Narratives
CLAUDE_API_KEY=your_anthropic_api_key_here

# News & Market Data APIs
NEWS_API_KEY=your_news_api_key_here

# Optional: Redfin API credentials for automated scraping
REDFIN_API_KEY=your_redfin_api_key_here

# Optional: Additional market data sources
MLS_API_KEY=your_mls_api_key_here
BROKER_EMAIL_ACCOUNT=your_email@domain.com
BROKER_EMAIL_PASSWORD=your_email_password

# App Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=PBN Realty
NEXT_PUBLIC_APP_DESCRIPTION=AI-Powered Commercial Real Estate Deal Analysis Platform
